# Скопируйте этот файл в .env и заполните своими значениями.
# .env не должен попадать в git.

# PostgreSQL (Supabase): строка подключения из Project Settings → Database
# Для prisma db push используйте прямое подключение или session pooler (порт 5432),
# для рантайма можно transaction pooler (порт 6543) с ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Storage (аватары, обложки, загрузки)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Секреты
JWT_SECRET="change-me"
RENPY_EVENT_TOKEN="change-me"

# Telegram-уведомления о безопасности (необязательно)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Настройки
PORT=3000
# Разрешённые фронтенды для CORS, через запятую (локальный Vite)
FRONTEND_ORIGIN="http://localhost:5173"
BACKEND_URL="http://localhost:3000"

ANTI_VPN_CHECK=false

# Путь к папке загрузок (локально)
UPLOAD_DIR=uploads
